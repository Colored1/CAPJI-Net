    <string name="login_creds_hint">Usuario y contraseña suelen estar en la etiqueta bajo el router (p. ej. admin / admin). Huawei fibra: telecomadmin o root. Una contraseña errónea puede bloquear algunos routers.</string>
    <string name="open_router_page">Abrir la página del router</string>
    <string name="note_pause_app">La pausa temporizada la hace la app: bloquea y desbloquea el dispositivo al terminar. Mantén la app abierta o desbloquea manualmente.</string>
    <string name="note_no_limit">El firmware de este módem no permite límites de velocidad por dispositivo. Usa bloqueo o pausa.</string>
    <string name="note_no_quota">Este módem no informa el consumo por dispositivo, así que no hay cuotas. Bloqueo y pausa siguen disponibles.</string>
    <string name="note_wifi_only_block">El bloqueo usa el filtro MAC Wi-Fi del router: solo dispositivos Wi-Fi (no cable).</string>
    <string name="note_hilink_lock">Huawei bloquea el acceso tras varios errores - revisa la contraseña antes de reintentar.</string>
    <string name="note_experimental_block">El bloqueo es experimental en este firmware. La app relee la regla del router y avisa si no fue aceptada.</string>
    <string name="note_zte_monitor">ZTE: dispositivos y bandas se leen del router. El bloqueo no tiene una página estable en ZTE - usa el botón de página del router y envía el diagnóstico para añadirlo.</string>
    <string name="note_scan_only">Dispositivos hallados al escanear tu Wi-Fi. Para bloquear, la app necesita el acceso admin de un router compatible.</string>
    <string name="note_no_mac">Android oculta las direcciones MAC: los dispositivos escaneados pueden aparecer por IP.</string>
    <string name="err_unreachable">No se puede llegar al router en %1$s. Comprueba el Wi-Fi y la dirección.</string>
    <string name="err_firmware">Página de acceso desconocida: firmware no compatible con el controlador %1$s. Copia el diagnóstico (Ajustes) y envíalo.</string>
    <string name="err_login_locked">El router bloqueó el acceso por demasiados intentos. Espera unos minutos (o reinícialo).</string>
    <string name="err_router_code">El router respondió con el error %1$s</string>
